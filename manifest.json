{
  "manifest_version": 3,
  "name": "Chwila czytania",
  "version": "0.1.7",
  "description": "Otwórz książkę, gdy z przyzwyczajenia wchodzisz na portal.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chwila czytania",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "reader.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
